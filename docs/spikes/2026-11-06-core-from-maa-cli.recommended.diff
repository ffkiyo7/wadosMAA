+// MARK: - SPIKE: Core-from-maa-cli runtime check (scratch only, not product code)
+
+enum SpikeCoreCheck {
+    /// Runs only when MAA_SPIKE_USER_DIR is set; prints results and exits the process.
+    static func runIfRequested() {
+        let env = ProcessInfo.processInfo.environment
+        guard let userDir = env["MAA_SPIKE_USER_DIR"] else { return }
+        let home = String(cString: getpwuid(getuid())!.pointee.pw_dir)
+        let base = env["MAA_SPIKE_BASE"] ?? home + "/Library/Application Support/com.loong.maa"
+        let hotUpdate = home + "/Library/Caches/com.loong.maa"
+        let userRes = home + "/.config/maa-cli"
+        var allOK = true
+
+        func log(_ s: String) {
+            print("[spike] " + s)
+            fflush(stdout)
+        }
+
+        // Weak-link preflight: if libMaaCore was not found at launch, all Asst* symbols are NULL.
+        if dlsym(UnsafeMutableRawPointer(bitPattern: -2), "AsstGetVersion") == nil {  // RTLD_DEFAULT
+            log("PREFLIGHT: libMaaCore not loaded (weak-linked, app still launched)")
+            exit(3)
+        }
+
+        // Which dylibs did dyld actually map?
+        for i in 0..<_dyld_image_count() {
+            let name = String(cString: _dyld_get_image_name(i))
+            if name.range(of: "MaaCore|MaaUtils|opencv|onnxruntime|fastdeploy|AdbControl", options: .regularExpression) != nil {
+                log("dyld image: \(name)")
+            }
+        }
+        let sandboxed = env["APP_SANDBOX_CONTAINER_ID"] != nil
+        log("sandboxed(APP_SANDBOX_CONTAINER_ID set): \(sandboxed)")
+
+        func step(_ name: String, _ body: () -> Bool) {
+            let t0 = Date()
+            let ok = body()
+            allOK = allOK && ok
+            log(String(format: "%@ -> %@ (%.2fs)", name, ok ? "OK" : "FAIL", Date().timeIntervalSince(t0)))
+        }
+
+        step("AsstSetUserDir(\(userDir))") { AsstSetUserDir(userDir) != 0 }
+        step("AsstLoadResource(\(base))  [base resource]") { AsstLoadResource(base) != 0 }
+        step("AsstLoadResource(\(base)/MaaResource)  [git overlay]") { AsstLoadResource(base + "/MaaResource") != 0 }
+        if FileManager.default.fileExists(atPath: hotUpdate + "/resource") {
+            step("AsstLoadResource(\(hotUpdate))  [hot-update cache, extra]") { AsstLoadResource(hotUpdate) != 0 }
+        }
+        step("AsstLoadResource(\(userRes))  [user resource]") { AsstLoadResource(userRes) != 0 }
+        for b in [base + "/resource", hotUpdate + "/resource"] {
+            let p = b + "/platform_diff/iOS"
+            if FileManager.default.fileExists(atPath: p + "/resource") {
+                step("AsstLoadResource(\(p))  [platform_diff iOS, extra]") { AsstLoadResource(p) != 0 }
+            }
+        }
+
+        let version = AsstGetVersion().map { String(cString: $0) } ?? "<nil>"
+        log("AsstGetVersion() = \(version)")
+
+        let item = "30012".withCString { AsstGetItemName($0) }.map { String(cString: $0) } ?? "<nil>"
+        log("AsstGetItemName(30012) = \(item)")
+        let key = "1-7".withCString { AsstGetMapLevelKey($0) }
+        func s(_ p: UnsafePointer<CChar>?) -> String { p.map { String(cString: $0) } ?? "<nil>" }
+        log("AsstGetMapLevelKey(1-7) = code=\(s(key.code)) stage_id=\(s(key.stage_id)) level_id=\(s(key.level_id)) name=\(s(key.name))")
+        log("AsstGetNullSize() = \(AsstGetNullSize())")
+
+        let h = AsstCreateEx(nil, nil)
+        log("AsstCreateEx(nil,nil) = \(h == nil ? "nil" : "non-nil"); connected=\(h.map { AsstConnected($0) } ?? 255) running=\(h.map { AsstRunning($0) } ?? 255)")
+        if let h { AsstDestroy(h) }
+        log("AsstDestroy done")
+
+        log("RESULT: \(allOK ? "ALL OK" : "SOME FAILED")")
+        exit(allOK ? 0 : 1)
+    }
+}
